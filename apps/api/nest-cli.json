{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "assets": [
      {
        "include": "**/*.hbs",
        "outDir": "dist/src",
        "watchAssets": true
      }
    ],
    "watchOptions": {
      "preserveWatchOutput": true
    }
  }
}
